# =============================================================================
# BACKEND TRAVEL AGENCY — Variables de Entorno
# =============================================================================
# Copia este archivo como .env (NO se sube a Git) y completa los valores.
# Luego configura IntelliJ para que cargue estas variables al arrancar la app.
# Guía completa: docs/CONFIGURACION.md
# =============================================================================

# ─── Base de datos MySQL ────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/travel_agency
DB_USER=root
DB_PASSWORD=root

# ─── Cloudinary (gestión de imágenes) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ─── JWT (autenticación segura) ─────────────────────────────────────────────
# IMPORTANTE: usa una clave larga y segura (mínimo 32 caracteres)
JWT_SECRET=change_me_to_a_secure_random_secret_key

# ─── Mail (envío de emails post-compra) ─────────────────────────────────────
# Soporta cualquier servidor SMTP (Gmail, SendGrid, Mailtrap, etc.)
# Para Gmail: host=smtp.gmail.com, port=587, usar App Password de 16 caracteres
MAIL_HOST=tu_servidor_smtp
MAIL_PORT=587
MAIL_USERNAME=tu_email@ejemplo.com
MAIL_PASSWORD=tu_contraseña_o_app_password
MAIL_FROM=no-reply@travelagency.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
